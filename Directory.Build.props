<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1903 = transitive vulnerability advisory. Carved out so disclosure-window
         CVE alerts don't block local builds; CI/GHAS surfaces them separately. -->
    <WarningsNotAsErrors>NU1903</WarningsNotAsErrors>
    <!-- CA1848 (use LoggerMessage delegates) is a hot-path micro-optimisation;
         ClipNest's logging is all low-frequency lifecycle/per-capture events,
         so the source-generated-delegate boilerplate is not worth it.
         CA1716 (don't name members with reserved keywords, e.g. Stop) only
         matters for cross-language consumers (VB); ClipNest is C#-only, so
         natural names like Start/Stop are kept. Both silenced repo-wide. -->
    <NoWarn>$(NoWarn);CA1848;CA1716</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Company>ClipNest</Company>
    <Authors>ClipNest Contributors</Authors>
    <Product>ClipNest</Product>
    <Copyright>Copyright (c) ClipNest Contributors</Copyright>
    <Version>0.4.0</Version>
  </PropertyGroup>
</Project>
