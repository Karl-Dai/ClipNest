<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipNest.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28,20,28,16" RowSpacing="18" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="拾贴 ClipNest" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="复制过的内容，随时找回来。" Opacity="0.65"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ToggleButton x:Name="PauseButton" Content="暂停记录" Click="OnPauseClicked"/>
                <Button Content="设置" Click="OnSettingsClicked"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索内容或来源应用…" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索剪贴板历史"/>
            <ToggleButton Grid.Column="1" x:Name="FavoritesButton" Content="☆ 仅收藏" Click="OnFilterClicked"/>
            <ComboBox Grid.Column="2" x:Name="KindFilter" Width="118" SelectedIndex="0" SelectionChanged="OnKindChanged" AutomationProperties.Name="内容类型">
                <ComboBoxItem Content="所有类型" Tag=""/><ComboBoxItem Content="文本" Tag="text"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="文件" Tag="file"/><ComboBoxItem Content="颜色" Tag="color"/><ComboBoxItem Content="富文本" Tag="rtf"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="280"/><ColumnDefinition Width="3*" MinWidth="340"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <ListView x:Name="HistoryList" Margin="6" SelectionMode="Single" SelectionChanged="OnSelectionChanged" DoubleTapped="OnItemDoubleTapped" KeyDown="OnListKeyDown" AutomationProperties.Name="历史记录">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,12" RowSpacing="6">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24" IsHitTestVisible="False">
                        <TextBlock Text="这里还没有内容" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" Text="复制一段文字或一张图片，即可开始。" TextWrapping="Wrap" Opacity="0.6" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="22">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="6"><TextBlock x:Name="PreviewTitle" Text="内容预览" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PreviewMeta" Text="选择左侧记录查看详情" Opacity="0.55" TextWrapping="Wrap"/></StackPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="TextScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="PreviewText" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Cascadia Code, Microsoft YaHei UI" FontSize="14"/></ScrollViewer>
                        <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform"/></ScrollViewer>
                        <RichEditBox x:Name="RtfPreview" IsReadOnly="True" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" x:Name="ActionButtons">
                        <Button x:Name="PasteButton" Content="粘贴 ↵" Style="{StaticResource AccentButtonStyle}" Click="OnPasteClicked"/>
                        <Button Content="复制" Click="OnCopyClicked"/>
                        <Button x:Name="FavoriteButton" Content="☆ 收藏" Click="OnFavoriteClicked"/>
                        <Button Content="删除" Click="OnDeleteClicked"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="正在记录 · 数据仅保存在本机" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" x:Name="HotkeyHint" Text="Ctrl + Shift + V 唤出  ·  Esc 隐藏" FontSize="12" Opacity="0.55" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
