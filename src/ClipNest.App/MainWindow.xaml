<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ClipNest.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ClipNest.App">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" KeyDown="OnRootKeyDown" SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8"/>
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}"/><Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="MetaTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea" Background="Transparent" Margin="20,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8C8;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="拾贴" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="ClipNest" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,4,8,0">
            <ToggleButton x:Name="PauseButton" Width="32" Height="32" Padding="8" Click="OnPauseClicked" AutomationProperties.Name="暂停记录" ToolTipService.ToolTip="暂停记录"><FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14"/></ToggleButton>
            <Button Style="{StaticResource IconButtonStyle}" Click="OnSettingsClicked" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="OnDismissClicked" AutomationProperties.Name="收起面板" ToolTipService.ToolTip="收起（Esc）"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="16,4,16,8" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBox x:Name="SearchBox" Padding="38,10,34,10" MinHeight="44" FontSize="15" PlaceholderText="搜索内容或来源应用" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索剪贴板历史"/>
                        <FontIcon Glyph="&#xE721;" FontSize="16" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <SelectorBar x:Name="HistoryFilter" SelectionChanged="OnHistoryFilterChanged"><SelectorBarItem x:Name="RecentFilter" Text="最近" Icon="Clock" IsSelected="True"/><SelectorBarItem x:Name="SavedFilter" Text="收藏" Icon="Favorite"/></SelectorBar>
                <ComboBox Grid.Column="1" x:Name="KindFilter" Width="112" SelectedIndex="0" SelectionChanged="OnKindChanged" AutomationProperties.Name="内容类型" ToolTipService.ToolTip="按内容类型筛选">
                    <ComboBoxItem Content="所有类型" Tag=""/><ComboBoxItem Content="文本" Tag="text"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="文件" Tag="file"/><ComboBoxItem Content="颜色" Tag="color"/><ComboBoxItem Content="富文本" Tag="rtf"/>
                </ComboBox>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="2" Margin="8,0,8,0" x:Name="ContentArea">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="344"/></Grid.ColumnDefinitions>
            <Grid>
                <ListView x:Name="HistoryList" SelectionMode="Single" SelectionChanged="OnSelectionChanged" DoubleTapped="OnItemDoubleTapped" KeyDown="OnListKeyDown" AutomationProperties.Name="历史记录">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="8"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryRow">
                            <Grid Padding="4,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid><FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" Visibility="{x:Bind ThumbnailVisibility}"/></Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Title}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE735;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="{x:Bind FavoriteVisibility}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8C8;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="EmptyTitle" Text="从一次复制开始" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Text="复制文字、图片或文件，拾贴会替你记住。" TextWrapping="Wrap" Style="{StaticResource MetaTextStyle}" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Border x:Name="PreviewPane" Grid.Column="1" Margin="16,0,0,0" Padding="20" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8"><TextBlock Text="内容预览" Style="{StaticResource MetaTextStyle}"/><TextBlock x:Name="PreviewTitle" Text="选择一条记录" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PreviewMeta" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,0"/></StackPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="TextScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="PreviewText" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="15" LineHeight="24"/></ScrollViewer>
                        <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform"/></ScrollViewer>
                        <RichEditBox x:Name="RtfPreview" IsReadOnly="True" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="↑ ↓ 选择    ·    Enter 粘贴" Style="{StaticResource MetaTextStyle}"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="16,8,16,0" Spacing="8">
            <InfoBar x:Name="FeedbackBar" IsOpen="False" IsClosable="True" Severity="Informational"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" x:Name="ActionButtons">
                    <Button x:Name="PasteButton" Style="{StaticResource AccentButtonStyle}" Click="OnPasteClicked" Padding="18,8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77F;" FontSize="14"/><TextBlock Text="粘贴"/></StackPanel></Button>
                    <Button Click="OnCopyClicked" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="复制" ToolTipService.ToolTip="复制"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button>
                    <Button x:Name="FavoriteButton" Click="OnFavoriteClicked" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="收藏" ToolTipService.ToolTip="收藏"><FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="16"/></Button>
                    <Button Click="OnDeleteClicked" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="删除" ToolTipService.ToolTip="删除"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
                </StackPanel>
                <ToggleButton Grid.Column="1" x:Name="PreviewToggle" IsChecked="True" Click="OnPreviewClicked" Padding="10,8" AutomationProperties.Name="显示内容预览" ToolTipService.ToolTip="展开或收起内容预览"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A0;" FontSize="14"/><TextBlock Text="预览"/></StackPanel></ToggleButton>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="4" Margin="16,8,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" x:Name="HotkeyHint" Text="Ctrl + Shift + V 唤出" Style="{StaticResource MetaTextStyle}"/>
        </Grid>
    </Grid>
</Window>
